<views:DialogWindow x:Class="DigItPatcher.App.Views.ToolsWindow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DigItPatcher.App.Views"
                    xmlns:core="clr-namespace:DigItPatcher.Core;assembly=DigItPatcher.Core"
                    Title="Dig It! Toolset"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="24,20,24,18" MaxWidth="460">
        <TextBlock Text="Dig It! Toolset" FontSize="20"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="{x:Static core:DigItTools.HeaderLead}" /><Hyperlink Style="{StaticResource CreditLinkStyle}"
                              NavigateUri="{x:Static core:DigItTools.AuthorProfile}"
                              ToolTip="{x:Static core:DigItTools.AuthorProfile}"
                              RequestNavigate="Link_RequestNavigate"><Run Text="{x:Static core:DigItTools.Author}" /></Hyperlink><Run Text="{x:Static core:DigItTools.HeaderEnd}" /></TextBlock>

        <ItemsControl Margin="0,18,0,0" ItemsSource="{x:Static core:DigItTools.All}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Link" FontSize="14">
                                <Hyperlink Style="{StaticResource RepoLinkStyle}"
                                           NavigateUri="{Binding Link}"
                                           ToolTip="{Binding Link}"
                                           RequestNavigate="Link_RequestNavigate"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                            </TextBlock>

                            <TextBlock x:Name="Plain" Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <Border Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>

                            <TextBlock x:Name="Here" FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource LinkHoverBrush}"><Run Text="← " /><Run Text="{x:Static core:DigItTools.HereMarker}" /></TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsThisApp}" Value="True">
                            <Setter TargetName="Link" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Plain" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Here" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="OK" IsDefault="True" IsCancel="True"
                MinWidth="88" Padding="12,4" Margin="0,8,0,0"
                HorizontalAlignment="Right" />
    </StackPanel>
</views:DialogWindow>
