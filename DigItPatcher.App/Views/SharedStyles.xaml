<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:DigItPatcher.App.Views"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <views:AllTrueConverter x:Key="AllTrueConverter" />

    <!-- Dims a section whose checkbox is clear, while leaving its text readable and its (i) usable. -->
    <sys:Double x:Key="UncheckedSectionOpacity">0.45</sys:Double>

    <Geometry x:Key="MinimizeIconGeometry">M0,5 L10,5</Geometry>
    <Geometry x:Key="CloseIconGeometry">M0,0 L10,10 M10,0 L0,10</Geometry>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{DynamicResource HoverColor}" />
        </Style.Resources>
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Style.Resources>
            <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{DynamicResource HoverColor}" />
        </Style.Resources>
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="ToolTip" Value="Close" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionIconPathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CloseCaptionIconPathStyle" TargetType="Path" BasedOn="{StaticResource CaptionIconPathStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource CaptionCloseIconBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppHyperlinkStyle" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AuthorLinkStyle" TargetType="Hyperlink" BasedOn="{StaticResource AppHyperlinkStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AuthorLinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RepoLinkStyle" TargetType="Hyperlink" BasedOn="{StaticResource AppHyperlinkStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CreditLinkStyle" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AuthorLinkHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHeaderCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="InfoButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource MutedIconBrush}" BorderThickness="1">
                        <TextBlock x:Name="Glyph" Text="i" FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource MutedIconBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmphasisBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource EmphasisBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmphasisBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource EmphasisBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExplanationToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MenuPopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExplanationHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <Style x:Key="ExplanationBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="3" />
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Height" Value="30" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="3" />
    </Style>

    <Style x:Key="DialogWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- CaptionHeight must match the title row. GlassFrameThickness enables OS window drop shadow. -->
                <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" CornerRadius="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="32"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{TemplateBinding Title}" IsHitTestVisible="False"
                                               Foreground="{DynamicResource MenuHeaderBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="12,0,8,0" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource CloseCaptionButtonStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Path Style="{StaticResource CloseCaptionIconPathStyle}"
                                              Data="{StaticResource CloseIconGeometry}" />
                                    </Button>
                                </Grid>
                            </Border>
                            <AdornerDecorator>
                                <ContentPresenter />
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
