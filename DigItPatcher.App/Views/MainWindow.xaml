<Window x:Class="DigItPatcher.App.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DigItPatcher.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Dig It! Patcher"
        Icon="/Assets/AppIcon.ico"
        Width="620" MinWidth="620" MaxWidth="620"
        Height="540" MinHeight="540" MaxHeight="750"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource RegionBrush}">

    <!-- CaptionHeight matches title bar (32), GlassFrameThickness enables drop shadow, and horizontal resize is disabled. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0,6,0,6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/AppIcon.png" Width="16" Height="16" Margin="10,0,4,0"
                           VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" IsHitTestVisible="False"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource MenuHeaderBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Minimize"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <Path Style="{StaticResource CaptionIconPathStyle}" Data="{StaticResource MinimizeIconGeometry}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <Path Style="{StaticResource CloseCaptionIconPathStyle}" Data="{StaticResource CloseIconGeometry}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource StatusBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,5">
                <Grid>
                    <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}">
                        <Hyperlink Style="{StaticResource AppHyperlinkStyle}" TextDecorations="{x:Null}"
                                   Click="Identity_Click">
                            <Run Text="{Binding IdentityLine, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource PrimaryTextBrush}">
                        <Hyperlink Style="{StaticResource AppHyperlinkStyle}" TextDecorations="{x:Null}"
                                   Click="Tools_Click">Dig It! Toolset</Hyperlink>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid x:Name="ContentGrid" Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Game Folder:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" IsReadOnly="True" Height="26" VerticalContentAlignment="Center"
                                 Text="{Binding FolderPath, Mode=OneWay}" />
                        <Button Grid.Column="2" Content="Browse..." Height="26" MinWidth="86" Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}" IsEnabled="{Binding IsIdle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SubtitleStyle}" Margin="0,6,0,0"
                               Text="{Binding IdentificationLine}"
                               Visibility="{Binding HasFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0"
                            Visibility="{Binding HasFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <CheckBox Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                  Content="Repair a Damaged Copy"
                                  IsChecked="{Binding RepairChecked}">
                            <CheckBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                    <Binding Path="RepairOffered" />
                                    <Binding Path="IsIdle" />
                                </MultiBinding>
                            </CheckBox.IsEnabled>
                        </CheckBox>
                        <TextBlock Margin="24,4,0,0" Text="{Binding RepairSubtitle}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubtitleStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RepairChecked}" Value="False">
                                            <Setter Property="Opacity" Value="{StaticResource UncheckedSectionOpacity}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <CheckBox Style="{StaticResource SectionHeaderCheckBoxStyle}" Margin="0,18,0,0"
                                  Content="Apply Bug Fixes"
                                  IsChecked="{Binding FixesChecked}">
                            <CheckBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                    <Binding Path="FixesPending" />
                                    <Binding Path="IsIdle" />
                                </MultiBinding>
                            </CheckBox.IsEnabled>
                        </CheckBox>

                        <ItemsControl ItemsSource="{Binding Rows}" Margin="24,6,0,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FixesChecked}" Value="False">
                                            <Setter Property="Opacity" Value="{StaticResource UncheckedSectionOpacity}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FixRowViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">

                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                                        <Button Margin="8,0,0,0"
                                                Style="{StaticResource InfoButtonStyle}"
                                                Click="InfoButton_Click"
                                                GotKeyboardFocus="InfoButton_GotKeyboardFocus"
                                                LostKeyboardFocus="InfoButton_LostKeyboardFocus"
                                                ToolTipService.InitialShowDelay="200"
                                                ToolTipService.BetweenShowDelay="0"
                                                ToolTipService.ShowDuration="120000"
                                                ToolTipService.Placement="Custom"
                                                ToolTipOpening="InfoButton_ToolTipOpening">
                                            <Button.ToolTip>
                                                <!-- Custom placement callback uses HorizontalOffset and VerticalOffset to align below the button. -->
                                                <ToolTip Style="{StaticResource ExplanationToolTipStyle}"
                                                         Placement="Custom" HorizontalOffset="0" VerticalOffset="6">
                                                    <StackPanel MaxWidth="400">
                                                        <TextBlock Text="What Is Wrong" Style="{StaticResource ExplanationHeadingStyle}" Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding WhatIsWrong}" Style="{StaticResource ExplanationBodyStyle}" />
                                                        <TextBlock Text="Why It Happens" Style="{StaticResource ExplanationHeadingStyle}" />
                                                        <TextBlock Text="{Binding WhyItHappens}" Style="{StaticResource ExplanationBodyStyle}" />
                                                        <TextBlock Text="What Changes" Style="{StaticResource ExplanationHeadingStyle}" />
                                                        <TextBlock Text="{Binding WhatChanges}" Style="{StaticResource ExplanationBodyStyle}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <TextBlock Text="{Binding StateText}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="AlreadyFixed">
                                                            <Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="NotAvailable">
                                                            <Setter Property="Foreground" Value="{DynamicResource StateAttentionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="UnexpectedBytes">
                                                            <Setter Property="Foreground" Value="{DynamicResource StateAlarmBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"
                            Visibility="{Binding HasFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Restore Backup" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,10,0"
                            Command="{Binding RestoreBackupCommand}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                <Binding Path="BackupExists" />
                                <Binding Path="IsIdle" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Apply" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Cancel" Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,40,0,0" TextAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Select a Dig It! game folder to see what can be repaired and fixed.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFolder}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DockPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Log" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource CodeBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinHeight="90">
                        <Grid>
                        <TextBlock Text="{Binding WelcomeLine}" FontFamily="Consolas" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding LogIsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10,8">
                            <ItemsControl ItemsSource="{Binding Log}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogEntry}">
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Info">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                                            <Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource StateAttentionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource StateAlarmBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
