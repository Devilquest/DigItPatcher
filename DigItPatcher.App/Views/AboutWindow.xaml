<views:DialogWindow x:Class="DigItPatcher.App.Views.AboutWindow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DigItPatcher.App.Views"
                    Title="About Dig It! Patcher"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="24,20,24,18" MaxWidth="440">
        <TextBlock Text="Dig It! Patcher" FontSize="20"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock x:Name="VersionText" FontSize="12" Margin="0,4,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19" Margin="0,16,0,0"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Text="Repairs a damaged copy of Dig It! and fixes bugs in the original version." />

        <TextBlock FontSize="13" LineHeight="19" Margin="0,16,0,0"
                   Foreground="{DynamicResource PrimaryTextBrush}">
            <Run Text="Made with " /><Run Text="♥" FontSize="15" Foreground="{DynamicResource HeartBrush}" /><Run Text=" by" />
            <Hyperlink Style="{StaticResource AuthorLinkStyle}"
                       NavigateUri="https://github.com/Devilquest"
                       ToolTip="https://github.com/Devilquest"
                       RequestNavigate="Link_RequestNavigate">Devilquest</Hyperlink>
        </TextBlock>

        <TextBlock FontSize="13" LineHeight="19" Margin="0,4,0,0"
                   Foreground="{DynamicResource PrimaryTextBrush}">
            <Run Text="Source code:" />
            <Hyperlink Style="{StaticResource RepoLinkStyle}"
                       NavigateUri="https://github.com/Devilquest/DigItPatcher"
                       ToolTip="https://github.com/Devilquest/DigItPatcher"
                       RequestNavigate="Link_RequestNavigate">GitHub</Hyperlink>
        </TextBlock>

        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,16,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Dig It! © 1996 Pixel Painters Corp. This is an unofficial fan project, not affiliated with or endorsed by Pixel Painters Corp. or any publisher of the game. It redistributes no game assets: it only modifies an existing copy of the game, always creating a full backup beforehand." />

        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,16,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Released under the MIT license, which is included in the source repository." />

        <Button Content="OK" IsDefault="True" IsCancel="True"
                MinWidth="88" Padding="12,4" Margin="0,22,0,0"
                HorizontalAlignment="Right" />
    </StackPanel>
</views:DialogWindow>
